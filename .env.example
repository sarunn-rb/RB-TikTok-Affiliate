# Reviewer login
REVIEW_USER=reviewer
REVIEW_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# TikTok Shop Partner Center
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Seller authorization uses Service ID, which is distinct from App Key.
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_REDIRECT_URI=https://rb-tiktok-affiliate.vercel.app/api/tiktok/callback
# ROW or US. Thailand and other non-US markets use ROW.
TIKTOK_SHOP_MARKET=ROW
